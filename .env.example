# Copy to .env (docker compose reads it automatically; never commit .env).

# REQUIRED — Fernet key for data encrypted at rest (raw bank envelopes,
# SimpleFIN access URLs, webhook secrets). Next to docker-compose.yml (the
# first run pulls the published image; in a source clone, run
# `PURSER_ENCRYPTION_KEY=keygen docker compose build purser` first to use your
# own build):
#   docker run --rm "$(PURSER_ENCRYPTION_KEY=keygen docker compose config --images | grep -m1 '/purser:')" keygen
# RECORD IT somewhere safe: encrypted data is unrecoverable without it.
PURSER_ENCRYPTION_KEY=

# Postgres password for the bundled compose database (defaults to "purser").
#POSTGRES_PASSWORD=

# Base URL of the deployed docs site; search_docs (MCP) returns absolute
# links when set, site-relative paths when unset.
#PURSER_DOCS_URL=

# Purser answers on this machine only (127.0.0.1:8000) unless you change these.
# Another program already on port 8000: pick another host port.
#PURSER_HOST_PORT=8000
# Another machine on your home network (plain HTTP): set both, with this
# machine's own address. Beyond the home network, put your own HTTPS reverse
# proxy in front instead.
#PURSER_BIND_ADDRESS=0.0.0.0
#PURSER_PUBLIC_URL=http://192.168.1.20:8000

# The household time zone (IANA name). Settings -> General overrides it.
#PURSER_TIMEZONE=America/New_York
