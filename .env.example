# Copy to .env (docker compose reads it automatically; never commit .env).

# REQUIRED — Fernet key for data encrypted at rest (raw bank envelopes,
# SimpleFIN access URLs, webhook secrets). From a source checkout:
#   PURSER_ENCRYPTION_KEY=keygen docker compose build purser
#   PURSER_ENCRYPTION_KEY=keygen docker compose run --rm --no-deps purser keygen
# RECORD IT somewhere safe: encrypted data is unrecoverable without it.
PURSER_ENCRYPTION_KEY=

# Postgres password for the bundled compose database (defaults to "purser").
#POSTGRES_PASSWORD=

# Base URL of the deployed docs site; search_docs (MCP) returns absolute
# links when set, site-relative paths when unset.
#PURSER_DOCS_URL=

# Bind locally until first-admin setup is complete. Use HTTPS for remote access.
#PURSER_BIND_ADDRESS=127.0.0.1
#PURSER_PUBLIC_URL=http://localhost:8000
