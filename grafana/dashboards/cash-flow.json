{
  "__inputs": [
    {
      "name": "DS_PURSER",
      "label": "Purser (PostgreSQL)",
      "description": "Read-only purser_read connection to the Purser database",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "postgres",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "uid": "purser-cash-flow",
  "title": "Purser \u00b7 Monthly cash flow by category",
  "description": "Server-side category aggregation over the flat transactions contract.",
  "tags": [
    "purser"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now+30d"
  },
  "panels": [
    {
      "id": 1,
      "title": "Spending by category / month",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_PURSER}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT month, category_path, total FROM readmodel.v1_spending_by_category_month ORDER BY month, total DESC",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "${DS_PURSER}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "stacking": "normal",
        "xTickLabelRotation": -45
      }
    },
    {
      "id": 2,
      "title": "Recent transactions (flat view)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_PURSER}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT date, amount, account_path, category_path, status FROM readmodel.v2_transactions_flat ORDER BY date DESC LIMIT 50",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "${DS_PURSER}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
