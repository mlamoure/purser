{
  "name": "purser-admin",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:widgets": "node scripts/build-widgets.mjs",
    "check:widgets": "node scripts/check-widgets-selfcontained.mjs",
    "widgets:harness": "vite --config vite.harness.config.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.widgets.json",
    "test": "vitest run",
    "generate": "openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "4.14.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
